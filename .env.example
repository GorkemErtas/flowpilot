# Local Next.js/Prisma configuration. Replace placeholders; never commit .env.
# For a hosted database, use the provider's TLS and pooling settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowpilot?schema=public&connection_limit=1&pool_timeout=10"

# Required only for integration, browser and persistence verification tests.
# Must be a SEPARATE database whose name ends with _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowpilot_test?schema=public"

# Optional: use an installed Edge browser instead of Playwright Chromium.
# PLAYWRIGHT_CHANNEL="msedge"
